
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * UniQueue Security Rules - Prototype Version
     * 
     * CORE PHILOSOPHY
     * This ruleset enforces a strict Role-Based Access Control (RBAC) and Department-Based Access Control (DBAC) 
     * model. Security is driven by the user's document state and a dedicated superadmin collection.
     * 
     * DATA STRUCTURE
     * - /roles_superadmin/{userId}: Presence of a document grants global administrative access.
     * - /users/{userId}: User profiles containing 'role' and 'departmentId'.
     * - /departments/{departmentId}: Top-level organizational units.
     * - /departments/{departmentId}/counters/{counterId}: Counters scoped to a department.
     * - /departments/{departmentId}/tickets/{ticketId}: Queue tickets scoped to a department.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_superadmin/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function belongsToDept(deptId) {
      // Robust check: ensures user exists and has a deptId
      return isSignedIn() && (isSuperadmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().departmentId == deptId));
    }

    function hasRole(role) {
      return isSignedIn() && (isSuperadmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role));
    }

    // --- Collection Rules ---

    match /roles_superadmin/{userId} {
      allow get: if isSignedIn();
      allow list: if isSuperadmin();
      allow create, update, delete: if isSuperadmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperadmin();
      allow list: if isSuperadmin();
      allow create: if isOwner(userId) || isSuperadmin();
      allow update: if isExistingOwner(userId) || isSuperadmin();
      allow delete: if isSuperadmin();
    }

    match /departments/{departmentId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSuperadmin();
    }

    match /departments/{departmentId}/counters/{counterId} {
      allow get: if isSignedIn();
      allow list: if belongsToDept(departmentId);
      allow create: if isSuperadmin() || (hasRole('DeptAdmin') && belongsToDept(departmentId));
      allow update: if resource != null && (isSuperadmin() || (belongsToDept(departmentId) && (hasRole('DeptAdmin') || hasRole('Staff'))));
      allow delete: if resource != null && (isSuperadmin() || (hasRole('DeptAdmin') && belongsToDept(departmentId)));
    }

    match /departments/{departmentId}/tickets/{ticketId} {
      // Students scan QR codes, so 'get' and 'list' are available to signed-in/anonymous users
      // to support public monitor views and status tracking.
      allow get, list: if isSignedIn();

      // Kiosks create tickets. Ensure the ticket's departmentId matches the path.
      allow create: if isSignedIn() && request.resource.data.departmentId == departmentId;

      // Staff and Admins update ticket statuses (e.g., Calling, Serving, Completed).
      allow update: if resource != null && (isSuperadmin() || (belongsToDept(departmentId) && (hasRole('DeptAdmin') || hasRole('Staff'))));

      // Deletions typically restricted to Admins or Superadmins.
      allow delete: if resource != null && (isSuperadmin() || (hasRole('DeptAdmin') && belongsToDept(departmentId)));
    }
  }
}
