
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * UniQueue Security Rules
     * 
     * Security is driven by the user's document state and a dedicated superadmin collection.
     * Some read operations are public to support public monitors and student tracking.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_superadmin/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function belongsToDept(deptId) {
      return isSignedIn() && (isSuperadmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().departmentId == deptId));
    }

    function hasRole(role) {
      return isSignedIn() && (isSuperadmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role));
    }

    // --- Collection Rules ---

    match /roles_superadmin/{userId} {
      allow get: if isSignedIn();
      allow list: if isSuperadmin();
      allow create, update, delete: if isSuperadmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperadmin();
      allow list: if isSuperadmin();
      allow create: if isOwner(userId) || isSuperadmin();
      allow update: if isOwner(userId) || isSuperadmin();
      allow delete: if isSuperadmin();
    }

    match /departments/{departmentId} {
      // Departments are public so students can browse services
      allow get, list: if true;
      allow create, update, delete: if isSuperadmin();
    }

    match /departments/{departmentId}/counters/{counterId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSuperadmin() || (hasRole('DeptAdmin') && belongsToDept(departmentId));
      // For prototype: allow signed in users to update counters (for staff terminal)
      allow update: if isSignedIn();
      allow delete: if isSuperadmin() || (hasRole('DeptAdmin') && belongsToDept(departmentId));
    }

    match /departments/{departmentId}/tickets/{ticketId} {
      // Public monitor and student mobile tracking need public access
      allow get, list: if true;

      // Kiosks and status pages create/update.
      allow create: if isSignedIn();

      // Staff and Admins update ticket statuses. 
      // For prototype: allow any signed in user to update (for anonymous staff demo)
      allow update: if isSignedIn();

      // Deletions typically restricted to Admins.
      allow delete: if isSuperadmin() || (hasRole('DeptAdmin') && belongsToDept(departmentId));
    }
  }
}
