
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * UniQueue Security Rules
     * 
     * Security is driven by the user's document state and a dedicated superadmin collection.
     * We've also whitelisted specific institutional emails for Admin access.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_superadmin/$(request.auth.uid)) ||
        (request.auth.token.email_verified && request.auth.token.email in [
          'ramiljr.deocariza@neu.edu.ph',
          'djemandreif.reyes@neu.edu.ph',
          'johnmarc.sanchez@neu.edu.ph',
          'jermainecarl.miranda@neu.edu.ph'
        ])
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /roles_superadmin/{userId} {
      allow get: if isSignedIn();
      allow list: if isSuperadmin();
      allow create, update, delete: if isSuperadmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperadmin();
      allow list: if isSuperadmin();
      allow create: if isOwner(userId) || isSuperadmin();
      allow update: if isOwner(userId) || isSuperadmin();
      allow delete: if isSuperadmin();
    }

    match /departments/{departmentId} {
      // Departments are public so students can browse services
      allow read: if true;
      allow create, update, delete: if isSuperadmin();
    }

    match /departments/{departmentId}/counters/{counterId} {
      // Public monitor needs to see counter status
      allow read: if true;
      // Allow signed in users to manage counters
      allow write: if isSignedIn();
    }

    match /departments/{departmentId}/tickets/{ticketId} {
      // Public monitor and student mobile tracking need public access
      allow read: if true;
      // Allow signed in users (Kiosks/Staff/Students) to manage tickets
      allow write: if isSignedIn();
    }
  }
}
