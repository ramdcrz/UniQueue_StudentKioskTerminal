
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * UniQueue Security Rules
     * 
     * Security is driven by the user's document state and a dedicated superadmin collection.
     * For the prototype, we allow signed-in users (including anonymous staff) to manage 
     * tickets and counters to ensure a smooth demo experience.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_superadmin/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function belongsToDept(deptId) {
      return isSignedIn() && (isSuperadmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().departmentId == deptId));
    }

    function hasRole(role) {
      return isSignedIn() && (isSuperadmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role));
    }

    // --- Collection Rules ---

    match /roles_superadmin/{userId} {
      allow get: if isSignedIn();
      allow list: if isSuperadmin();
      allow create, update, delete: if isSuperadmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperadmin();
      allow list: if isSuperadmin();
      allow create: if isOwner(userId) || isSuperadmin();
      allow update: if isOwner(userId) || isSuperadmin();
      allow delete: if isSuperadmin();
    }

    match /departments/{departmentId} {
      // Departments are public so students can browse services
      allow read: if true;
      allow create, update, delete: if isSuperadmin();
    }

    match /departments/{departmentId}/counters/{counterId} {
      // Public monitor needs to see counter status
      allow read: if true;
      // Allow signed in users to manage counters for prototype demo
      allow write: if isSignedIn();
    }

    match /departments/{departmentId}/tickets/{ticketId} {
      // Public monitor and student mobile tracking need public access
      allow read: if true;
      // Allow signed in users (Kiosks/Staff) to manage tickets
      allow write: if isSignedIn();
    }
  }
}
