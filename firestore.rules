rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * UniQueue Security Rules - Prototype Version
     * 
     * CORE PHILOSOPHY
     * This ruleset enforces a strict Role-Based Access Control (RBAC) and Department-Based Access Control (DBAC) 
     * model. Security is driven by the user's document state and a dedicated superadmin collection.
     * 
     * DATA STRUCTURE
     * - /roles_superadmin/{userId}: Presence of a document grants global administrative access.
     * - /users/{userId}: User profiles containing 'role' and 'departmentId'.
     * - /departments/{departmentId}: Top-level organizational units.
     * - /departments/{departmentId}/counters/{counterId}: Counters scoped to a department.
     * - /departments/{departmentId}/tickets/{ticketId}: Queue tickets scoped to a department.
     * 
     * KEY SECURITY DECISIONS
     * 1. Authorization Independence: Critical fields like 'departmentId' are denormalized into subcollections 
     *    (Counters, Tickets) to allow rules to validate access without parent-document lookups.
     * 2. Identity Source of Truth: All decisions are based on the Firebase Auth UID.
     * 3. Kiosk Authorization: Kiosks are treated as a specific user role, allowing them to create tickets 
     *    only for their assigned department.
     * 4. Public QR Access: Tickets are readable by any authenticated (including anonymous) user to facilitate 
     *    QR code scanning for status updates, while list operations remain restricted to staff.
     * 
     * PROTOTYPING MODE
     * Rules strictly enforce "Who" can access data, but remain flexible on "What" data is written,
     * omitting strict schema validation to allow for rapid iterative development.
     */

    // --- Helper Functions ---

    /** Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the user is a Superadmin via the dedicated collection. */
    function isSuperadmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_superadmin/$(request.auth.uid));
    }

    /** Fetches the requesting user's profile document. */
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /** Checks if the authenticated user's ID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Checks if the user is the owner and the document exists (for updates/deletes). */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /** Checks if the user belongs to a specific department. */
    function belongsToDept(deptId) {
      return isSignedIn() && (getUserData().departmentId == deptId || isSuperadmin());
    }

    /** Checks if the user has a specific role. */
    function hasRole(role) {
      return isSignedIn() && (getUserData().role == role || isSuperadmin());
    }

    // --- Collection Rules ---

    /**
     * @description Identification collection for Superadmin privileges (Existence-based).
     * @path /roles_superadmin/{userId}
     * @allow get: if isSignedIn();
     * @deny create, update, delete: if !isSuperadmin();
     * @principle DBAC - Existence over Content principle for global privileges.
     */
    match /roles_superadmin/{userId} {
      allow get: if isSignedIn();
      allow list: if isSuperadmin();
      allow create, update, delete: if isSuperadmin();
    }

    /**
     * @description User profile documents containing roles and department assignments.
     * @path /users/{userId}
     * @allow get: if isOwner(userId) || isSuperadmin();
     * @deny list: if !isSuperadmin();
     * @principle Restricts access to a user's own profile while allowing Superadmin oversight.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperadmin();
      allow list: if isSuperadmin();
      allow create: if isOwner(userId) || isSuperadmin();
      allow update: if isExistingOwner(userId) || isSuperadmin();
      allow delete: if isSuperadmin();
    }

    /**
     * @description Global department definitions.
     * @path /departments/{departmentId}
     * @allow get, list: if isSignedIn();
     * @deny write: if !isSuperadmin();
     * @principle Public read for authenticated users; write restricted to Superadmins.
     */
    match /departments/{departmentId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSuperadmin();
    }

    /**
     * @description Physical service counters within a department.
     * @path /departments/{departmentId}/counters/{counterId}
     * @allow list: if belongsToDept(departmentId);
     * @deny update: if !belongsToDept(departmentId) || resource == null;
     * @principle Department-scoped access control with denormalized path validation.
     */
    match /departments/{departmentId}/counters/{counterId} {
      allow get: if isSignedIn();
      allow list: if belongsToDept(departmentId);
      allow create: if isSuperadmin() || (hasRole('DeptAdmin') && belongsToDept(departmentId));
      allow update: if resource != null && (isSuperadmin() || (belongsToDept(departmentId) && (hasRole('DeptAdmin') || hasRole('Staff'))));
      allow delete: if resource != null && (isSuperadmin() || (hasRole('DeptAdmin') && belongsToDept(departmentId)));
    }

    /**
     * @description Queue tickets organized by department.
     * @path /departments/{departmentId}/tickets/{ticketId}
     * @allow get: if isSignedIn();
     * @allow create: if (hasRole('Kiosk') && belongsToDept(departmentId)) || isSuperadmin();
     * @deny list: if !belongsToDept(departmentId);
     * @principle QR code accessibility for students (get) combined with strict staff management (update/list).
     */
    match /departments/{departmentId}/tickets/{ticketId} {
      // Students scan QR codes, so 'get' must be available to signed-in/anonymous users.
      allow get: if isSignedIn();
      
      // Only staff/admins within the department or superadmins can list the queue.
      allow list: if belongsToDept(departmentId);

      // Kiosks create tickets. Ensure the ticket's departmentId matches the path.
      allow create: if (isSuperadmin() || (hasRole('Kiosk') && belongsToDept(departmentId))) && request.resource.data.departmentId == departmentId;

      // Staff and Admins update ticket statuses (e.g., Calling, Serving, Completed).
      allow update: if resource != null && (isSuperadmin() || (belongsToDept(departmentId) && (hasRole('DeptAdmin') || hasRole('Staff'))));

      // Deletions typically restricted to Admins or Superadmins.
      allow delete: if resource != null && (isSuperadmin() || (hasRole('DeptAdmin') && belongsToDept(departmentId)));
    }
  }
}